[global]
    monitor = 0
    follow = mouse
    width = 360
    height = 200
    origin = top-right
    offset = 12x42
    gap_size = 6
    notification_limit = 5
    progress_bar = true
    indicate_hidden = yes
    transparency = 8
    separator_height = 2
    padding = 10
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#89b4fa"
    corner_radius = 8
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    sort = yes
    icon_position = left
    mouse_left_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#1e1e2e"
    foreground = "#a6adc8"
    timeout = 5

[urgency_normal]
    background = "#1e1e2e"
    foreground = "#cdd6f4"
    timeout = 8

[urgency_critical]
    background = "#1e1e2e"
    foreground = "#f38ba8"
    frame_color = "#f38ba8"
    timeout = 0
