# secrets.zsh.example — copy to ~/.zsh/secrets.zsh and fill in.
#   cp ~/.zsh/secrets.zsh.example ~/.zsh/secrets.zsh
# The real ~/.zsh/secrets.zsh is git-ignored and MUST NOT be committed.

# Jira (jira-cli)
export JIRA_USER="you@example.com"
export JIRA_API_TOKEN="changeme"

# RescueTime (used by the /eod recap)
export RESCUETIME_API_KEY="changeme"

# Discord webhook (notifications)
export DISCORD_WEBHOOK_URL="changeme"
